# Local development only. Use Vercel's encrypted environment store for deployment values.
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
CONTACT_API_URL=http://127.0.0.1:8000
CONTACT_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
CONTACT_ALLOWED_ORIGIN=http://127.0.0.1:3000
CONTACT_CLIENT_IP_HEADER=x-forwarded-for
DATABASE_URL=postgresql+psycopg://portfolio:replace-with-a-local-development-password@127.0.0.1:5432/portfolio
POSTGRES_PASSWORD=replace-with-a-local-development-password
PORTFOLIO_DB_PORT=5432
PORT=3000
PORTFOLIO_API_PORT=8000

# Keep unset for ordinary local development. The contact QA uses a local fake Resend endpoint.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=arajmir7@gmail.com
